#!/usr/bin/env bash
# Build the Llama Bar menu bar app.
#
#   bin/build-app [--no-open]         Install ~/Applications/Llama Bar.app (override with
#                                     INSTALL_DIR), ad hoc signed, driving this checkout.
#   bin/build-app --release <version> Write dist/Llama-Bar-<version>.zip: self-contained,
#                                     Developer ID signed and notarized, for GitHub releases,
#                                     and dist/appcast.xml, the update feed that announces it.
#
# Releases need a Developer ID Application certificate (override with SIGNING_IDENTITY),
# notarytool credentials saved as the keychain profile NOTARY_PROFILE (default
# "llama-bar"), preferably from an App Store Connect API key:
#   xcrun notarytool store-credentials llama-bar --key <AuthKey.p8> --key-id <id> --issuer <issuer>
# and the Sparkle update signing key in the keychain (see UPDATE_KEY_ACCOUNT below).
set -euo pipefail

ROOT="$(cd "$(dirname "$(realpath "$0")")/.." && pwd)"
PACKAGE="$ROOT/app"
APP_NAME="Llama Bar"
PROCESS_NAME="LlamaBar"
ICON_SCRIPT="$PACKAGE/scripts/make-icon.swift"
ICON_CACHE="$PACKAGE/.build/AppIcon.icns"
LSREGISTER=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister
NOTARY_PROFILE="${NOTARY_PROFILE:-llama-bar}"
SPARKLE_TOOLS="$PACKAGE/.build/artifacts/sparkle/Sparkle/bin"
# Installed apps only accept updates signed by the private half of UPDATE_PUBLIC_KEY, which
# generate_keys stored in the login keychain under UPDATE_KEY_ACCOUNT. Losing that key
# strands every installed copy on its current version: back it up with
#   app/.build/artifacts/sparkle/Sparkle/bin/generate_keys --account llama-bar -x <file>
UPDATE_KEY_ACCOUNT=llama-bar
UPDATE_PUBLIC_KEY="1YQ79qCcKeu4ynC9b8yTioYvxa6YandrLmJUvup85VY="
# Override only to test updates against a local server laid out like GitHub releases.
RELEASES_URL="${RELEASES_URL:-https://github.com/mcrolf/llama-bar/releases}"
# Always the newest release's copy, so the feed needs no hosting beyond GitHub releases.
FEED_URL="$RELEASES_URL/latest/download/appcast.xml"
# What a release copies into the app; see BundledRuntime.swift.
RUNTIME_FILES=(
  .env.example
  bin/setup bin/configure-server bin/opencode-ollama bin/uninstall
  launchd/com.mcrolf.llama-bar.ollama.plist.template
  opencode/generate_config.py opencode/opencode.json
)

WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

main() {
  case "${1:-}" in
    --release) [[ -n "${2:-}" ]] || usage; package_release "$2" ;;
    --no-open) install_local false ;;
    "") install_local true ;;
    *) usage ;;
  esac
}

usage() {
  echo "usage: bin/build-app [--no-open] | --release <version>" >&2
  exit 2
}

install_local() {
  local open_after_install="$1"
  local install_dir="${INSTALL_DIR:-$HOME/Applications}"
  local app="$install_dir/$APP_NAME.app"
  local staged
  staged="$(assemble_bundle 1.0.0)"
  plutil -insert LlamaBarRoot -string "$ROOT" "$staged/Contents/Info.plist"
  sign_bundle "$staged" --sign -

  mkdir -p "$install_dir"
  quit_running_app
  rm -rf "$app"
  # ditto rather than mv: the staging dir may be on another volume.
  ditto "$staged" "$app"
  "$LSREGISTER" -f "$app"
  $open_after_install && open "$app"
  echo "Installed: $app"
}

package_release() {
  local version="$1"
  local identity
  identity="$(signing_identity)"
  local staged
  staged="$(assemble_bundle "$version")"
  copy_runtime "$staged/Contents/Resources/runtime"
  enable_updates "$staged/Contents/Info.plist"
  sign_bundle "$staged" --options runtime --timestamp --sign "$identity"
  codesign --verify --deep --strict --verbose=2 "$staged"

  notarize "$staged"
  mkdir -p "$ROOT/dist"
  local archive="$ROOT/dist/Llama-Bar-$version.zip"
  rm -f "$archive"
  ditto -c -k --keepParent "$staged" "$archive"
  spctl --assess --type execute --verbose=2 "$staged"
  write_appcast "$archive" "$version"
  echo "Release: $archive and $ROOT/dist/appcast.xml"
}

# Only release builds get a feed; Updater.swift leaves updates off without one.
enable_updates() {
  local plist="$1"
  plutil -insert SUFeedURL -string "$FEED_URL" "$plist"
  plutil -insert SUPublicEDKey -string "$UPDATE_PUBLIC_KEY" "$plist"
  plutil -insert SUEnableAutomaticChecks -bool true "$plist"
}

# The feed lists only this release; older apps read it and update straight to it. It is
# generated in an empty folder because generate_appcast merges into an existing feed.
# generate_appcast also checks that the archive's SUPublicEDKey matches the keychain key.
write_appcast() {
  local archive="$1" version="$2" archives="$WORK/appcast"
  mkdir -p "$archives"
  cp "$archive" "$archives/"
  "$SPARKLE_TOOLS/generate_appcast" "$archives" \
    --account "$UPDATE_KEY_ACCOUNT" \
    --download-url-prefix "$RELEASES_URL/download/v$version/" \
    --link "$RELEASES_URL"
  cp "$archives/appcast.xml" "$ROOT/dist/appcast.xml"
}

# Nested code is signed before what contains it. Sparkle's Downloader service is
# sandboxed, so it keeps its entitlements.
sign_bundle() {
  local app="$1"; shift
  local sparkle="$app/Contents/Frameworks/Sparkle.framework"
  local sparkle_version="$sparkle/Versions/B"
  codesign --force "$@" "$sparkle_version/XPCServices/Installer.xpc"
  codesign --force "$@" --preserve-metadata=entitlements "$sparkle_version/XPCServices/Downloader.xpc"
  codesign --force "$@" "$sparkle_version/Autoupdate" "$sparkle_version/Updater.app"
  codesign --force "$@" "$sparkle"
  codesign --force "$@" "$app"
}

signing_identity() {
  if [[ -n "${SIGNING_IDENTITY:-}" ]]; then echo "$SIGNING_IDENTITY"; return; fi
  local identity
  identity="$(security find-identity -v -p codesigning | sed -n 's/.*"\(Developer ID Application: .*\)"/\1/p' | head -1)"
  [[ -n "$identity" ]] || { echo "No Developer ID Application certificate in the keychain." >&2; exit 1; }
  echo "$identity"
}

notarize() {
  local app="$1" submission="$WORK/notarize.zip"
  if ! xcrun notarytool history --keychain-profile "$NOTARY_PROFILE" >/dev/null 2>&1; then
    echo "No notarytool credentials named '$NOTARY_PROFILE'. Save them once with:" >&2
    echo "  xcrun notarytool store-credentials $NOTARY_PROFILE --key <AuthKey.p8> --key-id <key-id> --issuer <issuer-id>" >&2
    exit 1
  fi
  ditto -c -k --keepParent "$app" "$submission"
  xcrun notarytool submit "$submission" --keychain-profile "$NOTARY_PROFILE" --wait
  xcrun stapler staple "$app"
}

# Prints the path of an unsigned bundle staged in $WORK. Build output goes to stderr so
# callers can capture the path.
assemble_bundle() {
  local version="$1" bundle="$WORK/$APP_NAME.app" bin_dir
  bin_dir="$(swift build -c release --package-path "$PACKAGE" --show-bin-path)"
  swift build -c release --package-path "$PACKAGE" >&2
  build_icon >&2

  mkdir -p "$bundle/Contents/MacOS" "$bundle/Contents/Resources" "$bundle/Contents/Frameworks"
  cp "$bin_dir/$PROCESS_NAME" "$bundle/Contents/MacOS/$PROCESS_NAME"
  ditto "$bin_dir/Sparkle.framework" "$bundle/Contents/Frameworks/Sparkle.framework"
  cp "$ICON_CACHE" "$bundle/Contents/Resources/AppIcon.icns"
  write_info_plist "$bundle/Contents/Info.plist" "$version"
  echo "$bundle"
}

copy_runtime() {
  local runtime="$1" file
  for file in "${RUNTIME_FILES[@]}"; do
    mkdir -p "$runtime/$(dirname "$file")"
    cp -p "$ROOT/$file" "$runtime/$file"
  done
}

build_icon() {
  [[ -f "$ICON_CACHE" && "$ICON_CACHE" -nt "$ICON_SCRIPT" ]] && return

  local iconset="$WORK/AppIcon.iconset" master="$WORK/icon-1024.png" size
  mkdir -p "$iconset" "$(dirname "$ICON_CACHE")"
  swift "$ICON_SCRIPT" "$master"
  for size in 16 32 64 128 256 512 1024; do
    sips -z "$size" "$size" "$master" --out "$WORK/icon-$size.png" >/dev/null
  done
  for size in 16 32 128 256 512; do
    cp "$WORK/icon-$size.png" "$iconset/icon_${size}x${size}.png"
    cp "$WORK/icon-$((size * 2)).png" "$iconset/icon_${size}x${size}@2x.png"
  done
  iconutil -c icns "$iconset" -o "$ICON_CACHE"
}

write_info_plist() {
  local plist="$1" version="$2"
  plutil -create xml1 "$plist"
  plutil -insert CFBundleIdentifier -string com.mcrolf.llama-bar "$plist"
  plutil -insert CFBundleName -string "$APP_NAME" "$plist"
  plutil -insert CFBundleDisplayName -string "$APP_NAME" "$plist"
  plutil -insert CFBundleExecutable -string "$PROCESS_NAME" "$plist"
  plutil -insert CFBundlePackageType -string APPL "$plist"
  plutil -insert CFBundleShortVersionString -string "$version" "$plist"
  plutil -insert CFBundleVersion -string "$version" "$plist"
  plutil -insert CFBundleIconFile -string AppIcon "$plist"
  plutil -insert LSMinimumSystemVersion -string 15.0 "$plist"
  plutil -insert LSUIElement -bool true "$plist"
  plutil -insert NSHighResolutionCapable -bool true "$plist"
  plutil -lint "$plist" >/dev/null
}

quit_running_app() {
  pkill -x "$PROCESS_NAME" || true
  local attempt
  for attempt in {1..50}; do
    pgrep -x "$PROCESS_NAME" >/dev/null || return 0
    sleep 0.1
  done
  echo "warning: $PROCESS_NAME is still running" >&2
}

main "$@"
