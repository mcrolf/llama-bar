<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.mcrolf.llama-bar.ollama</string>
  <key>ProgramArguments</key>
  <array><string>__OLLAMA_BIN__</string><string>serve</string></array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>OLLAMA_HOST</key><string>127.0.0.1:11434</string>
    <key>OLLAMA_CONTEXT_LENGTH</key><string>__OLLAMA_CONTEXT_LENGTH__</string>
    <key>OLLAMA_KEEP_ALIVE</key><string>__OLLAMA_KEEP_ALIVE__</string>
    <key>OLLAMA_FLASH_ATTENTION</key><string>1</string>
    <key>OLLAMA_KV_CACHE_TYPE</key><string>q8_0</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__LOG_DIR__/ollama.log</string>
  <key>StandardErrorPath</key><string>__LOG_DIR__/ollama.log</string>
</dict>
</plist>
